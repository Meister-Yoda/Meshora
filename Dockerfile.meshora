FROM --platform=$BUILDPLATFORM golang:1.27.3 AS build
ARG TARGETOS=linux
ARG TARGETARCH=amd64
ARG VERSION=dev
ARG COMMIT=unknown
ARG BUILD_TIME=unknown
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 GOOS=$TARGETOS GOARCH=$TARGETARCH go build -trimpath \
    -ldflags "-s -w -X github.com/juanfont/headscale/hscontrol/types.buildVersion=$VERSION -X github.com/juanfont/headscale/hscontrol/types.buildCommit=$COMMIT -X github.com/juanfont/headscale/hscontrol/types.buildTime=$BUILD_TIME" \
    -o /out/headscale ./cmd/headscale

FROM gcr.io/distroless/base-debian13
COPY --from=build /out/headscale /usr/local/bin/headscale
COPY --from=build /src/LICENSE /LICENSE
COPY packaging/docker/config.yaml /etc/meshora/config.yaml
EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/headscale"]
CMD ["serve", "--config", "/etc/meshora/config.yaml"]
